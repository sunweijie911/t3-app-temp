    "vnd",
    "wbout",
    "wch",
    "wecom",
    "wedoc",
    "weixin"
  ],
  "flagWords": [],
  "patterns": [
    {
      "name": "jwt-token",
      "pattern": "/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/g"
    },
    {
      "name": "css-var",
      "pattern": "/--[a-zA-Z][a-zA-Z0-9-]*/g"
    },
    {
      "name": "import-path",
      "pattern": "/@\\/[a-zA-Z0-9/-]+/g"
    },
    {
      "name": "platform-resource-id",
      "pattern": "/\\b(?:tbl|bas|apc|doc|shtcn)[A-Za-z0-9]{8,}\\b/g"
    }
  ],
  "ignoreRegExpList": [
    "jwt-token",
    "css-var",
    "import-path",
    "platform-resource-id"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "drizzle/**",
    "public/**",
    "pnpm-lock.yaml",
    "*.tsbuildinfo"
  ]
}
