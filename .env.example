# ============================================================
# .env.example — 环境变量模板
# ============================================================
# .env 已被 gitignore，克隆仓库后请复制本文件并重命名为 .env，填入真实配置。
# 本文件会提交到版本控制，请勿在此填写任何密钥或敏感信息。
# 新增环境变量时，需同步更新 /src/env.js 中的校验 schema。

# ============================================================
# 数据库
# ============================================================
# PostgreSQL 连接地址（必填）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/t3-app-temp"

# ============================================================
# 认证 (Better Auth)
# ============================================================
# 用于签发/验证 JWT 的密钥（生产环境必填，可通过 openssl rand -base64 32 生成）
BETTER_AUTH_SECRET=""
# 应用访问地址（生产环境必填）
# 本地开发: http://localhost:5000（对应 docker-compose 的 HOST_PORT，默认 5000）
# 生产环境: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:5000"

# ============================================================
# 权限
# ============================================================
# 管理员邮箱白名单，多个用英文逗号分隔（可选）
ADMIN_EMAILS=""
# 管理员手机号白名单，多个用英文逗号分隔（可选）
ADMIN_PHONES=""

# ============================================================
# 邮箱 SMTP（email-otp 方式需要）
# ============================================================
# 开发环境验证码打印到控制台，无需配置。
# 生产环境：登录 QQ 邮箱 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成授权码
# SMTP 服务器地址和端口（默认 QQ 邮箱 smtp.qq.com:465）
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# ============================================================
# 阿里云短信（phone-otp 方式需要）
# ============================================================
# 开发环境验证码打印到控制台，无需配置。
# 生产环境：在 https://dysms.console.aliyun.com 注册，创建签名和模板。
# 模板须包含 code 变量，例如：您的验证码为：${code}，5分钟内有效。
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_CODE=""

# ============================================================
# LLM (大语言模型)
# ============================================================
# LLM 服务的 API Key，支持 DeepSeek、OpenAI 等（可选，也可在管理后台设置）
LLM_API_KEY=""
# LLM baseURL 白名单域名，逗号分隔（防止 SSRF）
# 为空则使用内置默认值：api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,api.anthropic.com
# LLM_ALLOWED_HOSTS="api.deepseek.com,api.openai.com"

# ============================================================
# 敏感数据加密
# ============================================================
# 身份证号等敏感字段的 AES-256 加密密钥（生产环境必填，可通过 openssl rand -base64 32 生成）
ID_CARD_ENCRYPTION_KEY=""

# ============================================================
# 钉钉 LINK 网关
# ============================================================
# 测试环境: http://cloudinter-linkgatewaytest.sto.cn/gateway/link.do
# 正式环境: https://cloudinter-linkgateway.sto.cn/gateway/link.do
DINGTALK_LINK_GATEWAY=""

# ============================================================
# IM Bot — 群聊机器人
# ============================================================
# LLM 服务配置（默认使用 DeepSeek）
# IM_BOT_LLM_BASE_URL="https://api.deepseek.com"
IM_BOT_LLM_API_KEY=""
# IM_BOT_LLM_MODEL="deepseek-chat"

# 飞书应用凭证（飞书开放平台 → 应用详情 → 凭证与基础信息）
IM_BOT_FEISHU_APP_ID=""
IM_BOT_FEISHU_APP_SECRET=""
# 飞书事件订阅安全配置（飞书开放平台 → 事件订阅 → 加密策略）
# IM_BOT_FEISHU_VERIFICATION_TOKEN 必填（DB 或此处二选一），缺失时 Webhook 直接 403
# IM_BOT_FEISHU_ENCRYPT_KEY 在飞书后台开启加密推送时必填
IM_BOT_FEISHU_ENCRYPT_KEY=""
IM_BOT_FEISHU_VERIFICATION_TOKEN=""

# IM Bot 销售场景 — 一次性 seed（容器启动时执行，幂等可重复）
# 设为 "true" 时容器启动后自动写入/更新 sales 场景与表格映射
# SEED_IM_BOT_SALES="false"
# 覆盖 seed 写入的飞书表（不同环境可对接不同 base/table；不设则用脚本默认值）
# IM_BOT_SALES_APP_TOKEN=""
# IM_BOT_SALES_TABLE_ID=""
# 多套同质场景共存时区分（默认 "sales"）
# IM_BOT_SALES_SCENE_ID="sales"

# 注：客户端变量 NEXT_PUBLIC_*（登录方式/站点名/模块配置）是【构建期】变量，
#     不在 .env 配置；生产配在 GitHub Actions Variables，详见 .github/workflows/build-deploy.yml。

# ============================================================
# 初始管理员（首次部署）
# ============================================================
# 容器启动时自动创建管理员账户，已存在则跳过。创建成功后可删除这三行。
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me"
# SEED_ADMIN_NAME="Admin"

# ============================================================
# 限流配置（可选，格式: "次数/窗口毫秒"，如 "10/60000" 表示每分钟10次）
# ============================================================
# 报告生成（默认 3次/分钟）
# RATE_LIMIT_REPORT_GENERATE="3/60000"
# AI 题目生成（默认 5次/分钟）
# RATE_LIMIT_QUESTION_GENERATE="5/60000"
# 大转盘抽奖（默认 10次/分钟）
# RATE_LIMIT_DRAW="10/60000"
# 文件上传（默认 5次/分钟）
# RATE_LIMIT_UPLOAD="5/60000"
# 钉钉免登接口（默认 30次/分钟）
# RATE_LIMIT_DINGTALK_USER_INFO="30/60000"
# 全局 IP 限流（默认 120次/分钟）
# RATE_LIMIT_GLOBAL_IP="120/60000"
# 登录/验证端点限流（不含发送，默认 20次/分钟；共享 NAT 出口 IP 时勿调太低以免误伤）
# RATE_LIMIT_AUTH_IP="20/60000"
# 验证码发送端点限流（有短信/邮件成本，默认 10次/分钟）
# RATE_LIMIT_OTP_SEND="10/60000"
# 验证码校验端点限流（覆盖 better-auth 内置过严/单位异常的默认规则，默认 10次/分钟；手输验证码勿调太低）
# RATE_LIMIT_OTP_VERIFY="10/60000"

# ============================================================
# 定时任务鉴权
# ============================================================
# Cron 接口的 Bearer Token 密钥（可选，通过 openssl rand -base64 32 生成）
# 用于 /api/cron/* 接口鉴权，云平台定时任务请求时需携带此密钥
# CRON_SECRET=""

# ============================================================
# 部署
# ============================================================
# Docker Compose Nginx 映射端口（默认 5000）
HOST_PORT=5000
# 仅 Docker 部署使用，设为 "true" 时容器启动后自动执行数据填充
# RUN_SEEDS="false"
