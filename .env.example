# .env 文件已被 gitignore，克隆仓库后请复制本文件并重命名为 .env，填入真实配置。
# 本文件会提交到版本控制，请勿在此填写任何密钥或敏感信息。
# 新增环境变量时，需同步更新 /src/env.js 中的校验 schema。

# Better Auth 使用的密钥
BETTER_AUTH_SECRET=""
# 应用访问地址（生产环境必填，例如 http://<服务器IP>:5000 或 https://yourdomain.com）
BETTER_AUTH_URL=""

# 管理员手机号白名单（多个用英文逗号分隔）
ADMIN_PHONES=""

# LLM（可选，也可在管理后台的系统配置中设置）
# LLM 服务的 API Key（支持 DeepSeek、OpenAI 等）
LLM_API_KEY=""

# 仅 Docker 部署使用，设为 "true" 时容器启动后自动执行数据填充
RUN_SEEDS="false"

# 阿里云短信（生产环境 OTP 发送必填）
# 在 https://dysms.console.aliyun.com 注册，创建签名和模板。
# 模板须包含 code 变量，例如：您的验证码为：${code}，5分钟内有效。
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_CODE=""

# Drizzle
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/t3-app-temp"
